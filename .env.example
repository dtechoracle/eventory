# Connect to Neon DB via connection pooling
# Example: postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for session authentication
JWT_SECRET="eventory-nexus-super-secret-jwt-key-replace-in-production"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
