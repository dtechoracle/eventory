# ==========================================
# EVENTORY NEXUS PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. Neon Database (Lakebase Postgres)
# Use the pooled connection for high-concurrency serverless query execution:
DATABASE_URL="postgresql://[user]:[password]@[neon_pooler_host]/neondb?channel_binding=require&sslmode=require"

# Direct unpooled connection (used for Prisma migrations / schema pushes):
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[neon_host]/neondb?channel_binding=require&sslmode=require"

# 2. Authentication & Sessions
# Must be a secure 32+ character random string in production (e.g. generated via openssl rand -base64 32):
JWT_SECRET="generate-a-strong-32-char-random-secret-for-production"

# Neon Auth Cookie Secret (Base64 32-byte secret):
NEON_AUTH_COOKIE_SECRET="generate-a-base64-random-secret-for-neon-auth"

# Neon Auth Endpoints:
NEON_AUTH_BASE_URL="https://[project-id].neonauth.[region].aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://[project-id].neonauth.[region].aws.neon.tech/neondb/auth/.well-known/jwks.json"

# 3. Public Domain / Host URL
# Set this to your live production domain (no trailing slash):
NEXT_PUBLIC_APP_URL="https://eventory.ng"

# 4. Neon Branch Information
NEON_BRANCH="production"
NEON_BRANCH_ID="[production-branch-id]"
NEON_FUNCTION_HOST_SUFFIX=".compute.[region].aws.neon.tech"

# 5. Neon Object Storage (S3-compatible bucket for event banners, vendor logos, media)
AWS_ACCESS_KEY_ID="[neon-storage-access-key-id]"
AWS_SECRET_ACCESS_KEY="[neon-storage-secret-key]"
AWS_ENDPOINT_URL_S3="https://[branch-id].storage.[region].aws.neon.tech"
AWS_REGION="us-east-2"
